# MongoDB
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/
MONGO_DB=shopriteDB
MONGO_COLLECTION=products

# Selenium (leave empty to use system PATH)
CHROME_DRIVER_PATH=

# Backend API (for api exporter)
API_URL=http://localhost:3000

# Scraper settings
MAX_PAGES=100
REQUEST_TIMEOUT=30
SELENIUM_TIMEOUT=20
